rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isCorporateEmail() {
      return signedIn()
        && (email().matches('.*@csgi[.]com$') || email().matches('.*@csg[.]com$'));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwnerUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin roster — writable only via Console / Admin SDK
    match /admins/{uid} {
      allow read: if isOwnerUid(uid) || isAdmin();
      allow write: if false;
    }

    // Employee profiles — public READ for live leaderboard (unsigned visitors);
    // writes still require corporate auth / admin
    match /participants/{docId} {
      allow read: if true;

      // Own profile doc is always participants/{auth.uid}
      allow create: if isCorporateEmail()
        && docId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailLower == email()
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'emailLower', 'employeeId', 'username', 'season'
        ])
        && !request.resource.data.keys().hasAny(['password', 'passwordHash']);

      // Allow owner to refresh season/profile fields on their own doc.
      // Older docs may be missing `uid`; ownership is enforced by docId == auth.uid.
      allow update: if isAdmin()
        || (
          isCorporateEmail()
          && docId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emailLower == email()
          && !request.resource.data.keys().hasAny(['password', 'passwordHash'])
        );

      allow delete: if isAdmin();
    }

    // Activity entries — public READ for day/overall boards; writes remain auth-gated
    match /stepEntries/{entryId} {
      allow read: if true;

      allow create: if isCorporateEmail()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'userUid', 'season', 'status', 'source'])
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.source in [
          'gps-counter', 'treadmill-counter', 'manual', 'native'
        ]
        && !request.resource.data.keys().hasAny(['password', 'screenshot']);

      // Owners may update their own stats; status changes remain admin-only
      // except pending→approved self-heal for legal finishes (validatedBy Day board auto-heal).
      allow update: if isAdmin()
        || (
          isCorporateEmail()
          && resource.data.userUid == request.auth.uid
          && request.resource.data.userUid == resource.data.userUid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['userUid', 'userId'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['status', 'validatedBy', 'validatedAt'])
            || (
              resource.data.status == 'pending'
              && request.resource.data.status == 'approved'
              && request.resource.data.validatedBy is string
            )
          )
        );

      allow delete: if isAdmin()
        || (isCorporateEmail() && resource.data.userUid == request.auth.uid);
    }

    // Team activity feed (optional photo posts after saving an activity)
    match /activityFeed/{postId} {
      allow read: if isCorporateEmail();

      allow create: if isCorporateEmail()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'id', 'userUid', 'userName', 'season', 'date', 'visible', 'entryId'
        ])
        && request.resource.data.season is string
        && request.resource.data.visible == true
        && !request.resource.data.keys().hasAny(['password', 'screenshot', 'photoBase64']);
        // photoUrl (Storage) and/or photoDataUrl (compressed JPEG data URL) are allowed

      allow update: if isAdmin()
        || (
          isCorporateEmail()
          && resource.data.userUid == request.auth.uid
          && request.resource.data.userUid == resource.data.userUid
        );

      allow delete: if isAdmin()
        || (isCorporateEmail() && resource.data.userUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
