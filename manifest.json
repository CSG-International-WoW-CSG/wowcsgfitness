{
  "name": "WOW-CSG Fitness",
  "short_name": "WOW-CSG Fitness",
  "description": "WOW-CSG Fitness — Track workouts, set goals, and move with CSG colleagues.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#003366",
  "theme_color": "#003366",
  "orientation": "portrait-primary",
  "lang": "en",
  "icons": [
    {
      "src": "icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": ["health", "fitness", "lifestyle"],
  "shortcuts": [
    {
      "name": "Start Activity",
      "short_name": "Track",
      "description": "Start outdoor or treadmill tracking",
      "url": "./index.html#dashboardCard",
      "icons": [{ "src": "icons/apple-touch-icon.png", "sizes": "180x180" }]
    },
    {
      "name": "Community",
      "short_name": "Community",
      "description": "View rankings and team feed",
      "url": "./index.html#leaderboardCard",
      "icons": [{ "src": "icons/apple-touch-icon.png", "sizes": "180x180" }]
    }
  ],
  "prefer_related_applications": false
