rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isCorporateEmail() {
      return signedIn()
        && (email().matches('.*@csgi[.]com$') || email().matches('.*@csg[.]com$'));
    }

    // Activity share photos: activity-photos/{uid}/{entryId}.jpg
    match /activity-photos/{userUid}/{fileName} {
      allow read: if isCorporateEmail();

      allow write: if isCorporateEmail()
        && request.auth.uid == userUid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isCorporateEmail()
        && request.auth.uid == userUid;
    }
  }
}
